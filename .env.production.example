# ============================================
# Scampanha - Production Environment Example
# ============================================
# Copie para .env.production e preencha os valores
# Localização: /opt/scampanha/.env.production

# Banco de dados
DB_NAME=scampanha
DB_USER=postgres
DB_PASSWORD=GERE_SENHA_FORTE_AQUI

# NextAuth
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=GERE_SENHA_FORTE_AQUI
NEXTAUTH_URL=http://SEU_IP_AQUI
